# =============================================================================
# PROJECT ZEAL – PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.production and fill in your actual values.

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=PLACEHOLDER
CLERK_SECRET_KEY=PLACEHOLDER

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname

# --- Cache (Upstash Redis) ---
PLACEHOLDER_REST_URL=https://xxx.upstash.io
PLACEHOLDER_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Storage (Cloudflare R2) ---
PLACEHOLDER_ID=xxxxxxxxxxxxx
PLACEHOLDER_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLACEHOLDER_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLACEHOLDER_NAME=zeal
PLACEHOLDER_URL=https://pub-xxx.r2.dev

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=PLACEHOLDER
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Real-time WebSocket ---
NEXT_PUBLIC_WS_URL=wss://api.zeal.com

# --- Video (LiveKit) ---
PLACEHOLDER_KEY=APIxxxxxxxxxxxxxxxx
PLACEHOLDER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLACEHOLDER_URL=wss://livekit.zeal.com

# --- AI (Groq) ---
GROQ_API_KEY=PLACEHOLDER

# --- AI (Zhipu) ---
PLACEHOLDER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI (Agnes) ---
PLACEHOLDER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: Sentry for error tracking ---
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: Vercel Analytics ---
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
